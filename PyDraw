from tkinter import *


class PyDraw:
    colors = {
        "1": "#000000",     
        "2": "#FFFFFF",
        "3": "#FF0000",
        "4": "#FF8000",
        "5": "#FFFF00",
        "6": "#00FF00",
        "7": "#00FFFF",
        "8": "#0080FF",
        "9": "#8000FF",
    }

    def __init__(self, root):
        self.root = root
        self.root.title("PyDraw")
        self.root.resizable(False, False)

        self.canvas_width = 800
        self.canvas_height = 500
        self.toolbar_height = 80

        self.pen_x = 0
        self.pen_y = 0
        self.pen_color = "1"
        
        self.effects = {}

        self.canvas = Canvas(
            root,
            width=self.canvas_width,
            height=self.canvas_height,
            bg="#FFFFFF"
        )
        self.canvas.pack()

        self.canvas.create_rectangle(
            0, 0, 802, self.toolbar_height,
            fill="#F0F0F0",
            outline="#000000"
        )

        positions = [1, 2, 4, 5, 6, 7, 8, 9, 10]

        for number, position in zip(self.colors, positions):
            x = 30 + position * 40
            color = self.colors[number]

            self.canvas.create_rectangle(
                x - 15, 10, x + 15, 40,
                fill=color,
                outline="#000000"
            )

            self.effects[number] = self.canvas.create_rectangle(
                x - 20, 5, x + 20, 45,
                outline="#000000",
                state=HIDDEN
            )

            self.canvas.create_text(x, 60, text=number)

        self.pen = self.canvas.create_rectangle(
            -4.5, -4.5, 4.5, 4.5,
            fill=self.colors[self.pen_color],
            outline=self.colors[self.pen_color]
        )

        self.canvas.move(
            self.pen,
            1 + self.canvas_width / 2,
            1 + self.canvas_height / 2 + self.toolbar_height / 2
        )

        self.text1 = self.canvas.create_text(
            625, 26, text="Move using the arrow keys"
        )
        self.text2 = self.canvas.create_text(
            625, 54, text='Press "space" to draw'
        )

        self.canvas.itemconfig(self.effects["1"], state=NORMAL)
        self.canvas.bind_all("<Key>", self.controls)
        self.blink_text()

    def controls(self, event):
        key = event.keysym

        if key in self.colors:
            self.pen_color = key
            color = self.colors[key]

            self.canvas.itemconfig(
                self.pen, fill=color, outline=color
            )

            for number, effect in self.effects.items():
                self.canvas.itemconfig(
                    effect,
                    state=NORMAL if number == key else HIDDEN
                )

        elif key == "Up" and self.pen_y >= -190:
            self.canvas.move(self.pen, 0, -10)
            self.pen_y -= 10

        elif key == "Down" and self.pen_y <= 190:
            self.canvas.move(self.pen, 0, 10)
            self.pen_y += 10

        elif key == "Left" and self.pen_x >= -380:
            self.canvas.move(self.pen, -10, 0)
            self.pen_x -= 10

        elif key == "Right" and self.pen_x <= 380:
            self.canvas.move(self.pen, 10, 0)
            self.pen_x += 10

        elif key == "space":
            color = self.colors[self.pen_color]

            self.pen = self.canvas.create_rectangle(
                -4.5, -4.5, 4.5, 4.5,
                fill=color,
                outline=color
            )

            self.canvas.move(
                self.pen,
                1 + self.canvas_width / 2 + self.pen_x,
                1 + self.canvas_height / 2
                + self.pen_y + self.toolbar_height / 2
            )

    def blink_text(self):
        state = self.canvas.itemcget(self.text1, "state")
        new_state = HIDDEN if state == "normal" else NORMAL

        self.canvas.itemconfig(self.text1, state=new_state)
        self.canvas.itemconfig(self.text2, state=new_state)

        self.root.after(500, self.blink_text)


if __name__ == "__main__":
    root = Tk()
    app = PyDraw(root)
    root.mainloop()
