<!DOCTYPE html>
<html lang="fi">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>World Generator</title>

<style>
    html, body {
        margin: 0;
        overflow: hidden;
        background: #87ceeb;
        font-family: sans-serif;
    }

    canvas {
        display: block;
    }

    #crosshair {
        position: fixed;
        top: 50%;
        left: 50%;
        width: 10px;
        height: 10px;
        transform: translate(-50%, -50%);
        z-index: 5;
        pointer-events: none;
    }

    #crosshair::before,
    #crosshair::after {
        content: "";
        position: absolute;
        background: white;
    }

    #crosshair::before {
        width: 10px;
        height: 2px;
        top: 4px;
        left: 0;
    }

    #crosshair::after {
        width: 2px;
        height: 10px;
        left: 4px;
        top: 0;
    }
</style>
</head>

<body>

<div id="crosshair"></div>

<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

function darken(hex, amount) {
    const c = new THREE.Color(hex);
    c.offsetHSL(0, -amount, 0);
    return c;
}

const skyColor = darken(0x87ceeb, 0.2);

const scene = new THREE.Scene();

scene.background = skyColor;

/*
 * Kasvatettu näkyvyyttä.
 * Aiemmin: 220
 */
scene.fog = new THREE.Fog(
    skyColor,
    60,
    400
);

const camera = new THREE.PerspectiveCamera(
    75,
    window.innerWidth / window.innerHeight,
    0.1,
    1000
);

const renderer = new THREE.WebGLRenderer({
    antialias: false
});

renderer.setSize(
    window.innerWidth,
    window.innerHeight
);

renderer.setPixelRatio(1);

document.body.appendChild(renderer.domElement);


/* =========================
   LIGHTING
========================= */

scene.add(
    new THREE.AmbientLight(
        0xffffff,
        0.9
    )
);

const sun = new THREE.DirectionalLight(
    0xffffff,
    0.7
);

sun.position.set(
    50,
    100,
    30
);

scene.add(sun);


/* =========================
   WORLD SETTINGS
========================= */

const WATER_LEVEL = 9;

const CHUNK_SIZE = 16;

/*
 * Simulointi-/latausetäisyys.
 *
 * 4  = 9 x 9 chunkia
 * 8  = 17 x 17 chunkia
 * 12 = 25 x 25 chunkia
 *
 * Nyt käytössä 8.
 */
const RENDER_DISTANCE = 8;


/* =========================
   WORLD DATA
========================= */

const chunks = new Map();

const waterChunks = new Map();

const clouds = [];

const treeColliders = [];


/* =========================
   BLOCK GEOMETRY
========================= */

const blockGeometry =
    new THREE.BoxGeometry(
        1,
        1,
        1
    );


/* =========================
   MATERIALS
========================= */

const materials = {

    grass:
        new THREE.MeshLambertMaterial({
            color: darken(
                0x5fb14a,
                0.2
            )
        }),

    dirt:
        new THREE.MeshLambertMaterial({
            color: darken(
                0x8a5a2b,
                0.2
            )
        }),

    stone:
        new THREE.MeshLambertMaterial({
            color: darken(
                0x888888,
                0.2
            )
        }),

    sand:
        new THREE.MeshLambertMaterial({
            color: darken(
                0xd9c27a,
                0.2
            )
        }),

    wood:
        new THREE.MeshLambertMaterial({
            color: darken(
                0x6b4423,
                0.2
            )
        }),

    leaves:
        new THREE.MeshLambertMaterial({
            color: darken(
                0x2f8f2f,
                0.2
            )
        })
};


/* =========================
   WATER
========================= */

const waterMaterial =
    new THREE.MeshLambertMaterial({
        color: darken(
            0x3399ff,
            0.2
        ),
        transparent: true,
        opacity: 0.82
    });


/* =========================
   TERRAIN NOISE
========================= */

function noise(x, z) {

    return (
        (
            Math.sin(x * 0.04) +
            Math.cos(z * 0.05)
        ) * 4 +

        Math.sin(
            (x + z) * 0.025
        ) * 6
    );
}


function getHeight(x, z) {

    let h =
        Math.floor(
            noise(x, z) * 0.5 + 10
        );

    h = Math.max(
        2,
        Math.min(
            18,
            h
        )
    );

    return h;
}


/* =========================
   TREE RANDOMNESS
========================= */

function treeValue(
    cx,
    cz,
    index,
    salt
) {

    const n =
        Math.sin(
            cx * 127.1 +
            cz * 311.7 +
            index * 74.7 +
            salt * 19.19
        ) *
        43758.5453;

    return n - Math.floor(n);
}


/* =========================
   CHUNK KEY
========================= */

function key(x, z) {

    return `${x},${z}`;
}


/* =========================
   INSTANCED BLOCKS
========================= */

function createInstanced(
    list,
    material,
    group
) {

    if (!list.length)
        return;

    const mesh =
        new THREE.InstancedMesh(
            blockGeometry,
            materials[material],
            list.length
        );

    const matrix =
        new THREE.Matrix4();

    for (
        let i = 0;
        i < list.length;
        i++
    ) {

        const p = list[i];

        matrix.setPosition(
            p[0],
            p[1],
            p[2]
        );

        mesh.setMatrixAt(
            i,
            matrix
        );
    }

    mesh.instanceMatrix.needsUpdate = true;

    group.add(mesh);
}


/* =========================
   BUILD CHUNK
========================= */

function buildChunk(cx, cz) {

    const k = key(cx, cz);

    if (chunks.has(k))
        return;

    const group =
        new THREE.Group();

    const blocks = {

        grass: [],
        dirt: [],
        stone: [],
        sand: []

    };


    for (
        let x = 0;
        x < CHUNK_SIZE;
        x++
    ) {

        for (
            let z = 0;
            z < CHUNK_SIZE;
            z++
        ) {

            const wx =
                cx * CHUNK_SIZE + x;

            const wz =
                cz * CHUNK_SIZE + z;

            const h =
                getHeight(
                    wx,
                    wz
                );


            for (
                let y = 0;
                y < h;
                y++
            ) {

                let type;


                if (
                    y === h - 1
                ) {

                    type =
                        h <= WATER_LEVEL
                            ? 'sand'
                            : 'grass';

                }

                else if (
                    y < h - 3
                ) {

                    type = 'stone';

                }

                else {

                    type = 'dirt';

                }


                blocks[type].push([
                    wx,
                    y,
                    wz
                ]);
            }
        }
    }


    for (
        const type in blocks
    ) {

        createInstanced(
            blocks[type],
            type,
            group
        );
    }


    generateTrees(
        group,
        cx,
        cz
    );


    scene.add(group);

    chunks.set(
        k,
        group
    );
}


/* =========================
   TREES
========================= */

function generateTrees(
    group,
    cx,
    cz
) {

    const trunks = [];

    const leaves = [];


    for (
        let i = 0;
        i < 2;
        i++
    ) {

        const tx =
            Math.floor(
                cx * CHUNK_SIZE +
                treeValue(
                    cx,
                    cz,
                    i,
                    1
                ) *
                CHUNK_SIZE
            );


        const tz =
            Math.floor(
                cz * CHUNK_SIZE +
                treeValue(
                    cx,
                    cz,
                    i,
                    2
                ) *
                CHUNK_SIZE
            );


        const h =
            getHeight(
                tx,
                tz
            );


        if (
            h <
            WATER_LEVEL + 1
        )
            continue;


        for (
            let y = 0;
            y < 3;
            y++
        ) {

            trunks.push([
                tx,
                h + y,
                tz
            ]);


            treeColliders.push({
                x: tx,
                y: h + y,
                z: tz
            });
        }


        for (
            let lx = -1;
            lx <= 1;
            lx++
        ) {

            for (
                let ly = 2;
                ly <= 4;
                ly++
            ) {

                for (
                    let lz = -1;
                    lz <= 1;
                    lz++
                ) {

                    if (
                        Math.abs(lx) +
                        Math.abs(lz) === 2 &&
                        ly === 4
                    )
                        continue;


                    leaves.push([
                        tx + lx,
                        h + ly,
                        tz + lz
                    ]);
                }
            }
        }
    }


    createInstanced(
        trunks,
        'wood',
        group
    );

    createInstanced(
        leaves,
        'leaves',
        group
    );
}


/* =========================
   WATER CHUNK
========================= */

function buildWater(cx, cz) {

    const k =
        "w_" +
        key(cx, cz);

    if (
        waterChunks.has(k)
    )
        return;


    const geometry =
        new THREE.PlaneGeometry(
            CHUNK_SIZE,
            CHUNK_SIZE
        );


    const mesh =
        new THREE.Mesh(
            geometry,
            waterMaterial
        );


    mesh.rotation.x =
        -Math.PI / 2;


    mesh.position.set(

        cx * CHUNK_SIZE +
        CHUNK_SIZE / 2,

        WATER_LEVEL - 1,

        cz * CHUNK_SIZE +
        CHUNK_SIZE / 2

    );


    scene.add(mesh);

    waterChunks.set(
        k,
        mesh
    );
}


/* =========================
   CLOUDS
========================= */

function spawnCloud(
    x,
    y,
    z
) {

    const size =
        19 +
        Math.random() * 23;


    const geometry =
        new THREE.BoxGeometry(
            size,
            size * 0.6,
            size
        );


    const material =
        new THREE.MeshBasicMaterial({
            color: 0xffffff,
            transparent: true,
            opacity: 0.95
        });


    const cloud =
        new THREE.Mesh(
            geometry,
            material
        );


    cloud.position.set(
        x,
        y,
        z
    );


    cloud.scale.set(

        0.95 +
        Math.random() * 0.3,

        0.55 +
        Math.random() * 0.2,

        0.95 +
        Math.random() * 0.3

    );


    scene.add(cloud);


    clouds.push({

        mesh: cloud,

        speed:
            0.01 +
            Math.random() * 0.02

    });
}


for (
    let i = 0;
    i < 80;
    i++
) {

    spawnCloud(

        (Math.random() - 0.5) *
        400,

        60 +
        30 * Math.random(),

        (Math.random() - 0.5) *
        400

    );
}


/* =========================
   PLAYER
========================= */

camera.position.set(
    0,
    18,
    25
);


let yaw = 0;

let pitch = 0;

let velocityY = 0;

let onGround = false;


const keys = {};


/* =========================
   KEYBOARD
========================= */

window.addEventListener(
    'keydown',
    e => {

        keys[
            e.key.toLowerCase()
        ] = true;

    }
);


window.addEventListener(
    'keyup',
    e => {

        keys[
            e.key.toLowerCase()
        ] = false;

    }
);


/* =========================
   POINTER LOCK
========================= */

renderer.domElement.addEventListener(
    'click',
    () => {

        renderer.domElement.requestPointerLock();

    }
);


window.addEventListener(
    'mousemove',
    e => {

        if (
            document.pointerLockElement !==
            renderer.domElement
        )
            return;


        yaw -=
            e.movementX *
            0.002;


        pitch -=
            e.movementY *
            0.002;


        pitch =
            Math.max(
                -1.4,
                Math.min(
                    1.4,
                    pitch
                )
            );

    }
);


/* =========================
   TREE COLLISION
========================= */

function collidesWithTree(
    x,
    z
) {

    const radius = 0.4;


    for (
        const block of treeColliders
    ) {

        if (

            Math.abs(
                x - block.x
            ) <
            0.5 + radius &&

            Math.abs(
                z - block.z
            ) <
            0.5 + radius

        ) {

            return true;

        }
    }


    return false;
}


/* =========================
   PLAYER MOVEMENT
========================= */

function movePlayer() {

    const speed = 0.18;


    let nx =
        camera.position.x;

    let nz =
        camera.position.z;


    if (keys.w) {

        nx -=
            Math.sin(yaw) *
            speed;

        nz -=
            Math.cos(yaw) *
            speed;

    }


    if (keys.s) {

        nx +=
            Math.sin(yaw) *
            speed;

        nz +=
            Math.cos(yaw) *
            speed;

    }


    if (keys.a) {

        nx -=
            Math.cos(yaw) *
            speed;

        nz +=
            Math.sin(yaw) *
            speed;

    }


    if (keys.d) {

        nx +=
            Math.cos(yaw) *
            speed;

        nz -=
            Math.sin(yaw) *
            speed;

    }


    if (
        !collidesWithTree(
            nx,
            nz
        )
    ) {

        camera.position.x = nx;

        camera.position.z = nz;

    }


    const floor =
        getHeight(
            camera.position.x,
            camera.position.z
        ) + 2;


    if (
        keys[" "] &&
        onGround
    ) {

        velocityY = 0.35;

        onGround = false;

    }


    velocityY -= 0.02;

    camera.position.y +=
        velocityY;


    if (
        camera.position.y <=
        floor
    ) {

        camera.position.y =
            floor;

        velocityY = 0;

        onGround = true;

    }
}


/* =========================
   WORLD UPDATE
========================= */

function updateWorld() {

    const pcx =
        Math.floor(
            camera.position.x /
            CHUNK_SIZE
        );


    const pcz =
        Math.floor(
            camera.position.z /
            CHUNK_SIZE
        );


    /*
     * Ladataan kaikki chunkit
     * RENDER_DISTANCE-etäisyydeltä.
     */
    for (
        let x = -RENDER_DISTANCE;
        x <= RENDER_DISTANCE;
        x++
    ) {

        for (
            let z = -RENDER_DISTANCE;
            z <= RENDER_DISTANCE;
            z++
        ) {

            buildChunk(
                pcx + x,
                pcz + z
            );


            buildWater(
                pcx + x,
                pcz + z
            );

        }
    }


    /*
     * Poistetaan liian kaukana
     * olevat maachunkit.
     */
    for (
        const [k, obj]
        of chunks
    ) {

        const [
            cx,
            cz
        ] =
            k
            .split(',')
            .map(Number);


        if (

            Math.abs(
                cx - pcx
            ) >
            RENDER_DISTANCE + 1 ||

            Math.abs(
                cz - pcz
            ) >
            RENDER_DISTANCE + 1

        ) {

            scene.remove(obj);

            chunks.delete(k);

        }
    }


    /*
     * Poistetaan liian kaukana
     * olevat vesichunkit.
     */
    for (
        const [k, obj]
        of waterChunks
    ) {

        const [
            cx,
            cz
        ] =
            k
            .replace(
                'w_',
                ''
            )
            .split(',')
            .map(Number);


        if (

            Math.abs(
                cx - pcx
            ) >
            RENDER_DISTANCE + 1 ||

            Math.abs(
                cz - pcz
            ) >
            RENDER_DISTANCE + 1

        ) {

            scene.remove(obj);

            waterChunks.delete(k);

        }
    }


    /*
     * Liikutetaan pilviä.
     */
    for (
        const c of clouds
    ) {

        c.mesh.position.x +=
            c.speed;


        if (
            c.mesh.position.x >
            camera.position.x + 250
        ) {

            c.mesh.position.x -=
                500;

        }
    }
}


/* =========================
   ANIMATION
========================= */

function animate() {

    requestAnimationFrame(
        animate
    );


    camera.rotation.order =
        'YXZ';


    camera.rotation.y =
        yaw;


    camera.rotation.x =
        pitch;


    movePlayer();

    updateWorld();


    renderer.render(
        scene,
        camera
    );
}


animate();


/* =========================
   RESIZE
========================= */

window.addEventListener(
    'resize',
    () => {

        camera.aspect =
            window.innerWidth /
            window.innerHeight;


        camera.updateProjectionMatrix();


        renderer.setSize(
            window.innerWidth,
            window.innerHeight
        );

    }
);

</script>

</body>
</html>
